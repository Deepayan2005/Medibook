<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MediBook" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="PasswordButtonStyle">
        <item name="android:layout_weight">1</item>
        <item name="backgroundTint">@color/white</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:layout_margin">5sp</item>
        <item name="strokeWidth">1sp</item>
        <item name="android:padding">10sp</item>
        <item name="strokeColor">#D2D0D3</item>
        <item name="cornerRadius">20sp</item>
        <item name="android:textSize">23sp</item>
    </style>



    <style name="CircleStyle">
        <item name="android:layout_margin">5sp</item>
        <item name="android:layout_width">20sp</item>
        <item name="android:layout_height">20sp</item>
    </style>

    <style name="ImageStyle">
        <item name="android:layout_margin">5sp</item>
        <item name="android:layout_width">40sp</item>
        <item name="android:layout_height">40sp</item>
    </style>

</resources>