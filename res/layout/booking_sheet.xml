<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/bookingControlsLayout"
        android:orientation="vertical"
        android:layout_margin="10sp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_gravity="center"
            android:textSize="18sp"
            android:gravity="center"
            android:textColor="@color/black"
            android:text="Select the patients who want to book appointment in "
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:id="@+id/unitNameView2"
            android:layout_gravity="center"
            android:textSize="18sp"
            android:gravity="center"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:text="@string/app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/materialContainer1"
            app:cardCornerRadius="10sp"
            app:cardElevation="5sp"
            android:layout_margin="10sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:text="Doctor Name"
                    android:layout_margin="5sp"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/doctorNameView2"
                    android:text="Doctor Name"
                    android:layout_margin="5sp"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/patientsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/bookingButton"
            android:text="Book Now"
            android:textAllCaps="false"
            android:textSize="17sp"
            app:cornerRadius="20sp"
            android:backgroundTint="#E91E63"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <ProgressBar
        android:id="@+id/loadingProgressBar"
        android:indeterminateTint="@color/purple_500"
        android:layout_width="match_parent"
        android:layout_margin="20sp"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:id="@+id/confirmationLayout"
        android:orientation="vertical"
        android:layout_margin="10sp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:text="Appoinment done !"
            android:textSize="18sp"
            android:layout_margin="10sp"
            android:layout_gravity="center"
            android:textColor="@color/black"
            android:layout_height="wrap_content"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/queueRecyclerView1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/okayButon"
            android:text="Okay"
            android:textAllCaps="false"
            android:textSize="17sp"
            app:cornerRadius="20sp"
            android:backgroundTint="#000000"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>

</LinearLayout>